GIGJAR_ENV=development
GIGJAR_LOG_LEVEL=info
GIGJAR_LOG_FORMAT=text
GIGJAR_DATABASE_URL=postgres://gigjar:gigjar@localhost:55432/gigjar?sslmode=disable
GIGJAR_HTTP_ADDR=:8090
GIGJAR_CORS_ALLOWED_ORIGINS=http://localhost:3000
GIGJAR_CHAIN_NETWORK=simulated
GIGJAR_SETTLEMENT_THRESHOLD=12
GIGJAR_SETTLEMENT_FEE=1
GIGJAR_PUBLIC_WEB_URL=http://localhost:3000
GIGJAR_SESSION_TTL=720h
GIGJAR_SECURE_COOKIES=false
GIGJAR_TRONGRID_API_KEY=
GIGJAR_SIGNER_SEED=
GIGJAR_SIGNER_TOKEN=
GIGJAR_ENERGY_PROVIDER=tronsave
